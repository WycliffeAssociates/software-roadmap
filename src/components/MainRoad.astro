---
import RoadSvg from "@svgs/RoadSvg.astro";
---

<div class="road-svg-window">
  <RoadSvg />
</div>

<style>
  .road-svg-window {
    /* road.ts switches this to fixed once it knows the layout: the road is
       moved by its own camera transform, and has to hold still on screen while
       a pinned section scrolls underneath it. */
    position: absolute;
    top: 0;
    left: 35%;
    width: 127px;
    height: 100vh;
    overflow: visible;
    display: block;
    z-index: 10;
    pointer-events: none;
  }
</style>
